{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["VITE_NETWORK_TYPE", "VITE_BACKEND_URL", "VITE_NODE_URL", "BASE_URL", "MODE", "EXPLORER_BASE_PATH"],
      "outputs": ["build/**"]
    },
    "start:app": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build:gh-pages": {
      "dependsOn": ["^build"],
      "env": ["VITE_NETWORK_TYPE", "VITE_BACKEND_URL", "VITE_NODE_URL", "BASE_URL", "MODE", "EXPLORER_BASE_PATH"],
      "outputs": ["build/**"]
    }
  }
}
